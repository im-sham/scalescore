# ScaleScore Environment Configuration
# Copy this file to .env and customize for your environment
# 
# See docs/adr/0009-configuration-management.md for details

# =============================================================================
# APPLICATION
# =============================================================================

# Environment: development | staging | production | testing
ENVIRONMENT=development

# Enable debug mode (NEVER enable in production)
DEBUG=true

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=DEBUG

# Log format: json | text
LOG_FORMAT=text

# =============================================================================
# SERVER
# =============================================================================

SERVER__HOST=0.0.0.0
SERVER__PORT=8000
SERVER__WORKERS=1
SERVER__RELOAD=true

# =============================================================================
# DATABASE
# =============================================================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=scalescore
DB_USER=scalescore
DB_PASSWORD=your_password_here
DB_POOL_SIZE=5
DB_POOL_OVERFLOW=10
DB_ECHO=false

# =============================================================================
# STORAGE
# =============================================================================

# Local SQLite path for immutable assessment report snapshots
STORAGE_ASSESSMENTS_DB_PATH=.local/scalescore/assessments.sqlite3

# Local SQLite path for auth state (users, API keys, refresh tokens)
STORAGE_AUTH_DB_PATH=.local/scalescore/auth.sqlite3

# Backward-compatible override for refresh token path (optional)
# STORAGE_REFRESH_TOKENS_DB_PATH=.local/scalescore/auth.sqlite3

# =============================================================================
# AUTHENTICATION
# =============================================================================

# JWT secret (MUST change in production)
AUTH_JWT_SECRET=CHANGE_ME_IN_PRODUCTION

# JWT algorithm (RS256 recommended for production)
AUTH_JWT_ALGORITHM=RS256

# Token expiration
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7

# Skip authentication in development (NEVER enable in production)
AUTH_SKIP_AUTH=true

# Auth endpoint throttling (basic abuse protection)
AUTH_LOGIN_RATE_LIMIT_REQUESTS=120
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_SIGNUP_RATE_LIMIT_REQUESTS=30
AUTH_SIGNUP_RATE_LIMIT_WINDOW_SECONDS=3600
AUTH_REFRESH_RATE_LIMIT_REQUESTS=120
AUTH_REFRESH_RATE_LIMIT_WINDOW_SECONDS=60

# RSA key paths (required for RS256 in production)
# AUTH_JWT_PRIVATE_KEY_PATH=/path/to/private.pem
# AUTH_JWT_PUBLIC_KEY_PATH=/path/to/public.pem

# =============================================================================
# INTEGRATIONS
# =============================================================================

# Optional shared secret for OpsOrchestra webhook ingestion
# INTEGRATION_OPSORCHESTRA_WEBHOOK_SECRET=replace-with-random-secret

# Allow private network/localhost integration URLs (keep false outside local development)
INTEGRATION_OPSORCHESTRA_ALLOW_PRIVATE_NETWORK=false

# Retry policy for OpsOrchestra HTTP calls
INTEGRATION_OPSORCHESTRA_HTTP_MAX_RETRIES=2
INTEGRATION_OPSORCHESTRA_HTTP_RETRY_BACKOFF_SECONDS=0.25

# Enable validation of OpsOrchestra-issued JWTs on protected routes
INTEGRATION_OPSORCHESTRA_AUTH_ENABLED=false

# Public key path for OpsOrchestra JWT verification (required when auth enabled)
# INTEGRATION_OPSORCHESTRA_JWT_PUBLIC_KEY_PATH=/path/to/opsorchestra-public.pem

# Optional JWKS endpoint (alternative to static public key path)
# INTEGRATION_OPSORCHESTRA_JWKS_URL=https://opsorchestra.example.com/.well-known/jwks.json
INTEGRATION_OPSORCHESTRA_JWKS_TIMEOUT_SECONDS=5
INTEGRATION_OPSORCHESTRA_JWKS_CACHE_TTL_SECONDS=300
INTEGRATION_OPSORCHESTRA_JWT_LEEWAY_SECONDS=30

# OpsOrchestra JWT verification and claim mapping
INTEGRATION_OPSORCHESTRA_JWT_ISSUER=opsorchestra
INTEGRATION_OPSORCHESTRA_JWT_AUDIENCE=scalescore-api
INTEGRATION_OPSORCHESTRA_SUB_CLAIM=sub
INTEGRATION_OPSORCHESTRA_TENANT_CLAIM=tenant_id
INTEGRATION_OPSORCHESTRA_TENANT_CLAIM_FALLBACKS=["tenant","tid"]
INTEGRATION_OPSORCHESTRA_EMAIL_CLAIM=email
INTEGRATION_OPSORCHESTRA_EMAIL_CLAIM_FALLBACKS=["upn","preferred_username"]
INTEGRATION_OPSORCHESTRA_ROLES_CLAIM=roles
INTEGRATION_OPSORCHESTRA_ROLES_CLAIM_FALLBACKS=["groups","scope","scp"]
INTEGRATION_OPSORCHESTRA_REQUIRE_EMAIL_CLAIM=true
INTEGRATION_OPSORCHESTRA_REQUIRE_ROLES_CLAIM=true

# Optional provider-neutral external OIDC JWT trust mode (for managed SSO deployments)
INTEGRATION_EXTERNAL_OIDC_AUTH_ENABLED=false
INTEGRATION_EXTERNAL_OIDC_PROVIDER_NAME=external-oidc
INTEGRATION_EXTERNAL_OIDC_ALLOW_PRIVATE_NETWORK=false
# INTEGRATION_EXTERNAL_OIDC_JWT_PUBLIC_KEY_PATH=/path/to/idp-public.pem
# INTEGRATION_EXTERNAL_OIDC_JWKS_URL=https://idp.example.com/.well-known/jwks.json
INTEGRATION_EXTERNAL_OIDC_JWKS_TIMEOUT_SECONDS=5
INTEGRATION_EXTERNAL_OIDC_JWKS_CACHE_TTL_SECONDS=300
INTEGRATION_EXTERNAL_OIDC_JWT_LEEWAY_SECONDS=30
# Required when INTEGRATION_EXTERNAL_OIDC_AUTH_ENABLED=true
INTEGRATION_EXTERNAL_OIDC_JWT_ISSUER=
INTEGRATION_EXTERNAL_OIDC_JWT_AUDIENCE=scalescore-api
INTEGRATION_EXTERNAL_OIDC_SUB_CLAIM=sub
INTEGRATION_EXTERNAL_OIDC_TENANT_CLAIM=tenant_id
INTEGRATION_EXTERNAL_OIDC_TENANT_CLAIM_FALLBACKS=["tid","tenant","org_id"]
INTEGRATION_EXTERNAL_OIDC_EMAIL_CLAIM=email
INTEGRATION_EXTERNAL_OIDC_EMAIL_CLAIM_FALLBACKS=["upn","preferred_username"]
INTEGRATION_EXTERNAL_OIDC_ROLES_CLAIM=roles
INTEGRATION_EXTERNAL_OIDC_ROLES_CLAIM_FALLBACKS=["groups","scope","scp"]
INTEGRATION_EXTERNAL_OIDC_REQUIRE_EMAIL_CLAIM=true
INTEGRATION_EXTERNAL_OIDC_REQUIRE_ROLES_CLAIM=true

# Optional graph-export endpoint for pulling entities from OpsOrchestra
# INTEGRATION_OPSORCHESTRA_GRAPH_EXPORT_URL=https://opsorchestra.example.com/api/v1/scalescore/export

# Optional bearer token for graph pull authentication
# INTEGRATION_OPSORCHESTRA_GRAPH_TOKEN=replace-with-random-token
INTEGRATION_OPSORCHESTRA_GRAPH_TIMEOUT_SECONDS=15
INTEGRATION_OPSORCHESTRA_GRAPH_MAX_ENTITIES_PER_TYPE=5000

# Optional webhook URL for pushing completed ScaleScore assessments to OpsOrchestra
# INTEGRATION_OPSORCHESTRA_OUTBOUND_URL=https://opsorchestra.example.com/api/v1/scalescore/events

# Optional bearer token used for outbound sync authentication
# INTEGRATION_OPSORCHESTRA_OUTBOUND_TOKEN=replace-with-random-token

# Timeout in seconds for outbound sync requests
INTEGRATION_OPSORCHESTRA_OUTBOUND_TIMEOUT_SECONDS=10

# =============================================================================
# SCORING ENGINE
# =============================================================================

SCORING_BASE_SCORE=100.0
SCORING_ASSESSMENT_VERSION=1.0
SCORING_GROWTH_MULTIPLIER_CAP=2.0
SCORING_TREND_DELTA_THRESHOLD=1.0

# Constraint severity weights
SCORING_CAPACITY_SEVERITY=15.0
SCORING_DEPENDENCY_SEVERITY=12.0
SCORING_GOVERNANCE_SEVERITY=8.0
SCORING_FINANCIAL_SEVERITY=20.0
SCORING_TALENT_SEVERITY=10.0
SCORING_TIMELINE_SEVERITY=5.0

# Risk level multipliers
SCORING_RISK_LOW_MULTIPLIER=0.5
SCORING_RISK_MEDIUM_MULTIPLIER=1.0
SCORING_RISK_HIGH_MULTIPLIER=1.5
SCORING_RISK_CRITICAL_MULTIPLIER=2.5

# =============================================================================
# FEATURE FLAGS
# =============================================================================

FEATURE_ENABLE_RECOMMENDATIONS=true
FEATURE_ENABLE_BOTTLENECK_DETECTION=true
FEATURE_ENABLE_DEPENDENCY_GRAPH=true

# Platform features (enable when implemented)
FEATURE_ENABLE_MULTI_TENANT=false
FEATURE_ENABLE_ASYNC_ASSESSMENTS=false
FEATURE_ENABLE_SCHEDULED_ASSESSMENTS=false

# Observability
FEATURE_ENABLE_TELEMETRY=false
FEATURE_ENABLE_AUDIT_LOGGING=true

# =============================================================================
# ASYNC ASSESSMENT WORKER
# =============================================================================

# Execution mode:
# - poll       = process one queued job on each async status poll request
# - background = run in-process worker loop inside API runtime
# - broker     = publish jobs to Redis and process via scalescore-worker
ASYNC_ASSESSMENT_MODE=poll

# Worker polling interval in seconds (poll/background modes)
ASYNC_ASSESSMENT_WORKER_POLL_INTERVAL_SECONDS=0.25

# Redis broker settings (required when ASYNC_ASSESSMENT_MODE=broker)
# Use rediss:// in staging/production.
# ASYNC_ASSESSMENT_BROKER_URL=redis://localhost:6379/0
ASYNC_ASSESSMENT_BROKER_QUEUE_NAME=scalescore:async-assessment:jobs
ASYNC_ASSESSMENT_BROKER_DEQUEUE_TIMEOUT_SECONDS=5
ASYNC_ASSESSMENT_BROKER_RESERVATION_TIMEOUT_SECONDS=300
ASYNC_ASSESSMENT_SCHEDULED_DISPATCH_POLL_INTERVAL_SECONDS=30
ASYNC_ASSESSMENT_SCHEDULED_DISPATCH_BATCH_SIZE=10

# Async upload abuse/resource controls
ASYNC_ASSESSMENT_SUBMIT_RATE_LIMIT_REQUESTS=60
ASYNC_ASSESSMENT_SUBMIT_RATE_LIMIT_WINDOW_SECONDS=60
ASYNC_ASSESSMENT_MAX_OUTSTANDING_JOBS_PER_TENANT=25
ASYNC_ASSESSMENT_MAX_UPLOAD_BYTES_PER_FILE=5000000

# =============================================================================
# OBSERVABILITY (Optional)
# =============================================================================

# OpenTelemetry collector endpoint
# OTLP_ENDPOINT=http://localhost:4317
